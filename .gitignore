/data/archive_*/
/data/cache/
/data/db/
/cache/
*.sqlite
*.sqlite-*
*.db

# Reference repos (cloned shallow; not part of this project)
references/

# Build / runtime artifacts (reports + extraction outputs).
# schemas/ is intentionally tracked — it's the upstream-PR deliverable.
reports/
runs/

# Node (Sprint 5 leanmcp_bridge)
node_modules/
*.tsbuildinfo
